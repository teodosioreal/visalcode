# Copie para /etc/systemd/system/rastreador.service e ajuste o caminho.
[Unit]
Description=Rastreador Google Ads + BuyGoods
After=network.target

[Service]
WorkingDirectory=/opt/visalcode/rastreador
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning server.js
Restart=always
RestartSec=3
User=www-data

[Install]
WantedBy=multi-user.target
